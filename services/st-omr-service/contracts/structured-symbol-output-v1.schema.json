{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scoremosaic://st-omr/structured-symbol-output/v1",
  "title": "ScoreMosaic ST-OMR structured synthetic symbol output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "fixture",
    "model",
    "coordinateSpace",
    "symbols",
    "boundaries"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "documentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "fixtureVersion", "inputSha256"],
      "properties": {
        "fixtureId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "fixtureVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
          "minLength": 3,
          "maxLength": 32
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "modelVersion", "modelSha256", "repositoryTestOnly"],
      "properties": {
        "modelId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "modelVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "minLength": 5,
          "maxLength": 32
        },
        "modelSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repositoryTestOnly": {"const": true}
      }
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "min", "max"],
      "properties": {
        "unit": {"const": "integer-grid"},
        "min": {"const": 0},
        "max": {"const": 4096}
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "bbox", "confidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{3}$",
            "minLength": 4,
            "maxLength": 4
          },
          "type": {
            "enum": [
              "staff",
              "measure",
              "clef",
              "time_signature",
              "notehead",
              "stem",
              "beam",
              "rest",
              "barline"
            ]
          },
          "bbox": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": {"type": "integer", "minimum": 0, "maximum": 4096},
              "y": {"type": "integer", "minimum": 0, "maximum": 4096},
              "width": {"type": "integer", "minimum": 1, "maximum": 4096},
              "height": {"type": "integer", "minimum": 1, "maximum": 4096}
            }
          },
          "confidence": {"type": "integer", "minimum": 0, "maximum": 1000}
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realOmrInference",
        "userInputAccepted",
        "httpInferenceEnabled",
        "musicXmlGenerated",
        "gatewayIntegration",
        "ensembleIntegration",
        "networkUsed",
        "gpuUsed",
        "persistentStorageUsed",
        "productionEligible"
      ],
      "properties": {
        "realOmrInference": {"const": false},
        "userInputAccepted": {"const": false},
        "httpInferenceEnabled": {"const": false},
        "musicXmlGenerated": {"const": false},
        "gatewayIntegration": {"const": false},
        "ensembleIntegration": {"const": false},
        "networkUsed": {"const": false},
        "gpuUsed": {"const": false},
        "persistentStorageUsed": {"const": false},
        "productionEligible": {"const": false}
      }
    }
  }
}
