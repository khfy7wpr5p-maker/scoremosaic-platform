{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scoremosaic://st-omr/structured-symbol-output/v1",
  "title": "ScoreMosaic ST-OMR structured synthetic symbol output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "fixture",
    "model",
    "coordinateSpace",
    "symbols",
    "boundaries"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "documentId": {"type": "string", "minLength": 1, "maxLength": 128},
    "fixture": {"type": "object"},
    "model": {"type": "object"},
    "coordinateSpace": {"type": "object"},
    "symbols": {"type": "array", "minItems": 1, "maxItems": 256},
    "boundaries": {"type": "object"}
  }
}
