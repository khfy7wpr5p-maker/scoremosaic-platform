{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scoremosaic://st-omr/synthetic-symbol-membership/v1",
  "title": "ScoreMosaic ST-OMR synthetic symbol membership v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "symbolArtifact", "coordinateSpace", "staffs", "measures", "memberships", "boundaries"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "documentId": {"const": "synthetic-symbol-membership-v1"},
    "symbolArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "canonicalSha256"],
      "properties": {
        "documentId": {"const": "synthetic-symbol-output-v1"},
        "canonicalSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "min", "max"],
      "properties": {
        "unit": {"const": "integer-grid"},
        "min": {"const": 0},
        "max": {"const": 4096}
      }
    },
    "staffs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["staffId", "sourceSymbolId", "bbox"],
        "properties": {
          "staffId": {"type": "string", "pattern": "^staff[0-9]{3}$"},
          "sourceSymbolId": {"type": "string", "pattern": "^s[0-9]{3}$"},
          "bbox": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": {"type": "integer", "minimum": 0, "maximum": 4096},
              "y": {"type": "integer", "minimum": 0, "maximum": 4096},
              "width": {"type": "integer", "minimum": 1, "maximum": 4096},
              "height": {"type": "integer", "minimum": 1, "maximum": 4096}
            }
          }
        }
      }
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["measureId", "staffId", "sourceSymbolId", "bbox"],
        "properties": {
          "measureId": {"type": "string", "pattern": "^measure[0-9]{3}$"},
          "staffId": {"type": "string", "pattern": "^staff[0-9]{3}$"},
          "sourceSymbolId": {"type": "string", "pattern": "^s[0-9]{3}$"},
          "bbox": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": {"type": "integer", "minimum": 0, "maximum": 4096},
              "y": {"type": "integer", "minimum": 0, "maximum": 4096},
              "width": {"type": "integer", "minimum": 1, "maximum": 4096},
              "height": {"type": "integer", "minimum": 1, "maximum": 4096}
            }
          }
        }
      }
    },
    "memberships": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbolId", "staffId"],
        "properties": {
          "symbolId": {"type": "string", "pattern": "^s[0-9]{3}$"},
          "staffId": {"type": "string", "pattern": "^staff[0-9]{3}$"},
          "measureId": {"type": "string", "pattern": "^measure[0-9]{3}$"}
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbolProducingModel", "realSymbolDetection", "musicalInterpretation", "pitchAssigned", "durationAssigned", "voiceAssigned", "attachmentRelations", "beamMembership", "chordRelations", "readingOrderSemantics", "notationGraph", "musicXmlGenerated", "userInputAccepted", "httpInferenceEnabled", "gatewayIntegration", "ensembleIntegration", "networkUsed", "gpuUsed", "persistentStorageUsed", "productionEligible"],
      "properties": {
        "symbolProducingModel": {"const": false},
        "realSymbolDetection": {"const": false},
        "musicalInterpretation": {"const": false},
        "pitchAssigned": {"const": false},
        "durationAssigned": {"const": false},
        "voiceAssigned": {"const": false},
        "attachmentRelations": {"const": false},
        "beamMembership": {"const": false},
        "chordRelations": {"const": false},
        "readingOrderSemantics": {"const": false},
        "notationGraph": {"const": false},
        "musicXmlGenerated": {"const": false},
        "userInputAccepted": {"const": false},
        "httpInferenceEnabled": {"const": false},
        "gatewayIntegration": {"const": false},
        "ensembleIntegration": {"const": false},
        "networkUsed": {"const": false},
        "gpuUsed": {"const": false},
        "persistentStorageUsed": {"const": false},
        "productionEligible": {"const": false}
      }
    }
  }
}
