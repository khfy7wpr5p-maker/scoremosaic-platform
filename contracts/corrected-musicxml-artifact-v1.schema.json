{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoremosaic.invalid/contracts/corrected-musicxml-artifact-v1.schema.json",
  "title": "ScoreMosaic Corrected MusicXML Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "jobId",
    "reviewerId",
    "reviewReportId",
    "reviewReportSha256",
    "baseCanonicalSha256",
    "revisionId",
    "revisionSha256",
    "stateSha256",
    "validationReportSha256",
    "blockingIssueCount",
    "unresolvedIssueCount",
    "mediaType",
    "byteSize",
    "musicXmlSha256",
    "safetyPolicyVersion",
    "safetyReportSha256",
    "regeneratedCanonicalSha256",
    "roundTripContractVersion",
    "expectedSemanticSha256",
    "regeneratedSemanticSha256",
    "roundTripMatch",
    "status",
    "immutable",
    "approvalEligible",
    "publicationEligible",
    "artifactId",
    "artifactRecordSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "scoremosaic-corrected-musicxml-artifact-v1" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "jobId": { "type": "string", "pattern": "^job_[A-Za-z0-9_-]{8,80}$" },
    "reviewerId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reviewReportId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reviewReportSha256": { "$ref": "#/$defs/hash" },
    "baseCanonicalSha256": { "$ref": "#/$defs/hash" },
    "revisionId": { "type": "string", "pattern": "^rev_[0-9a-f]{32}$" },
    "revisionSha256": { "$ref": "#/$defs/hash" },
    "stateSha256": { "$ref": "#/$defs/hash" },
    "validationReportSha256": { "$ref": "#/$defs/hash" },
    "blockingIssueCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "unresolvedIssueCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "mediaType": { "const": "application/vnd.recordare.musicxml+xml" },
    "byteSize": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "musicXmlSha256": { "$ref": "#/$defs/hash" },
    "safetyPolicyVersion": { "const": "scoremosaic-generated-musicxml-safety-v1" },
    "safetyReportSha256": { "$ref": "#/$defs/hash" },
    "regeneratedCanonicalSha256": { "$ref": "#/$defs/hash" },
    "roundTripContractVersion": { "const": "scoremosaic-review-musicxml-semantic-roundtrip-v1" },
    "expectedSemanticSha256": { "$ref": "#/$defs/hash" },
    "regeneratedSemanticSha256": { "$ref": "#/$defs/hash" },
    "roundTripMatch": { "const": true },
    "status": { "const": "draft" },
    "immutable": { "const": true },
    "approvalEligible": { "const": false },
    "publicationEligible": { "const": false },
    "artifactId": { "type": "string", "pattern": "^corrected_[0-9a-f]{32}$" },
    "artifactRecordSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
