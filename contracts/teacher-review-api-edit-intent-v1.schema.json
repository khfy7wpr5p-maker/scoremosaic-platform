{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoremosaic.invalid/contracts/teacher-review-api-edit-intent-v1.schema.json",
  "title": "ScoreMosaic Teacher Review API Edit Intent v1",
  "description": "Non-authoritative live-API intent for proposing one bounded musical edit. The browser supplies exact snapshot/evidence/target intent only; principal, tenant, authorization, current musical location, old-value precondition, command identity and authoritative ScoreEditCommand fields are resolved server-side before Stage 8-G can be invoked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "projectionSha256",
    "snapshot",
    "evidenceContext",
    "target",
    "operation",
    "reason"
  ],
  "properties": {
    "schemaVersion": {"const": "scoremosaic-teacher-review-api-edit-intent-v1"},
    "requestId": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9_-]{8,120}$"
    },
    "projectionSha256": {"$ref": "#/$defs/sha256"},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "evidenceContext": {"$ref": "#/$defs/evidenceContext"},
    "target": {"$ref": "#/$defs/target"},
    "operation": {"$ref": "#/$defs/operation"},
    "reason": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 500
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "nullableRevisionId": {
      "oneOf": [
        {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        {"type": "null"}
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "revisionId", "revisionSha256", "stateSha256"],
      "properties": {
        "kind": {"enum": ["base", "revision"]},
        "revisionId": {"$ref": "#/$defs/nullableRevisionId"},
        "revisionSha256": {"$ref": "#/$defs/nullableSha256"},
        "stateSha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "base"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "revisionId": {"type": "null"},
              "revisionSha256": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "revision"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "revisionId": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
              "revisionSha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "evidenceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueId", "differenceId"],
      "properties": {
        "issueId": {
          "oneOf": [
            {"type": "string", "pattern": "^issue_[A-Za-z0-9_-]{6,80}$"},
            {"type": "null"}
          ]
        },
        "differenceId": {
          "oneOf": [
            {"type": "string", "pattern": "^difference_[0-9a-f]{24}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partId", "measureId", "eventId"],
      "properties": {
        "partId": {"$ref": "#/$defs/id"},
        "measureId": {"$ref": "#/$defs/id"},
        "eventId": {"$ref": "#/$defs/id"}
      }
    },
    "operation": {
      "oneOf": [
        {"$ref": "score-edit-command-v1.schema.json#/$defs/setPitch"},
        {"$ref": "score-edit-command-v1.schema.json#/$defs/setEffectiveDuration"},
        {"$ref": "score-edit-command-v1.schema.json#/$defs/setDots"},
        {"$ref": "score-edit-command-v1.schema.json#/$defs/removeEvent"}
      ]
    }
  }
}
