{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoremosaic.local/contracts/polyphonic-engine-semantic-report-v1.schema.json",
  "title": "ScoreMosaic Polyphonic Per-Engine Semantic Report v1",
  "description": "Research-only per-engine aggregation. It intentionally contains no single overall accuracy score and no engine ranking/winner authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "observationCount", "engineReports", "metricPolicy", "boundaries", "reportSha256"],
  "properties": {
    "schemaVersion": {"const": "scoremosaic-polyphonic-engine-semantic-report-v1"},
    "status": {"enum": ["NO_OBSERVATIONS", "RESEARCH_METRICS_AVAILABLE"]},
    "observationCount": {"type": "integer", "minimum": 0},
    "engineReports": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/engineReport"}
    },
    "metricPolicy": {"$ref": "#/$defs/metricPolicy"},
    "boundaries": {"$ref": "#/$defs/boundaries"},
    "reportSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ratio": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "referenceKinds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TEACHER_GOLD", "MANUALLY_REVIEWED_FIXED_BASELINE"],
      "properties": {
        "TEACHER_GOLD": {"type": "integer", "minimum": 0},
        "MANUALLY_REVIEWED_FIXED_BASELINE": {"type": "integer", "minimum": 0}
      }
    },
    "successRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "attempted", "ratio"],
      "properties": {
        "success": {"type": "integer", "minimum": 0},
        "attempted": {"type": "integer", "minimum": 0},
        "ratio": {"$ref": "#/$defs/ratio"}
      }
    },
    "validityRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "available", "ratio"],
      "properties": {
        "valid": {"type": "integer", "minimum": 0},
        "available": {"type": "integer", "minimum": 0},
        "ratio": {"$ref": "#/$defs/ratio"}
      }
    },
    "metricAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availableObservationCount", "correct", "total", "ratio"],
      "properties": {
        "availableObservationCount": {"type": "integer", "minimum": 0},
        "correct": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "ratio": {"$ref": "#/$defs/ratio"}
      }
    },
    "methodMetricAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "availableObservationCount", "correct", "total", "ratio"],
      "properties": {
        "method": {"type": "string", "minLength": 1, "maxLength": 100},
        "availableObservationCount": {"type": "integer", "minimum": 0},
        "correct": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "ratio": {"$ref": "#/$defs/ratio"}
      }
    },
    "semanticMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitch", "duration", "onset", "voice", "staff", "tie", "tuplet"],
      "properties": {
        "pitch": {"$ref": "#/$defs/metricAggregate"},
        "duration": {"$ref": "#/$defs/metricAggregate"},
        "onset": {"$ref": "#/$defs/metricAggregate"},
        "voice": {"$ref": "#/$defs/metricAggregate"},
        "staff": {"$ref": "#/$defs/metricAggregate"},
        "tie": {"$ref": "#/$defs/metricAggregate"},
        "tuplet": {"$ref": "#/$defs/metricAggregate"}
      }
    },
    "distanceAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "availableObservationCount", "mean", "lowerIsBetter", "tednClaimed"],
      "properties": {
        "method": {"const": "CANONICAL_STRUCTURE_DISTANCE_V1"},
        "availableObservationCount": {"type": "integer", "minimum": 0},
        "mean": {"$ref": "#/$defs/ratio"},
        "lowerIsBetter": {"const": true},
        "tednClaimed": {"const": false}
      }
    },
    "teacherEditAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "availableObservationCount", "totalEdits", "totalMeasures", "totalPages", "editsPerMeasure", "editsPerPage"],
      "properties": {
        "method": {"const": "TEACHER_REVISION_COMMAND_COUNT_V1"},
        "availableObservationCount": {"type": "integer", "minimum": 0},
        "totalEdits": {"type": "integer", "minimum": 0},
        "totalMeasures": {"type": "integer", "minimum": 0},
        "totalPages": {"type": "integer", "minimum": 0},
        "editsPerMeasure": {"$ref": "#/$defs/ratio"},
        "editsPerPage": {"$ref": "#/$defs/ratio"}
      }
    },
    "engineReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "observationCount", "referenceKinds", "musicXmlParseSuccess", "structuralValidity", "semanticMetrics", "measureConsistency", "relationCorrectness", "structuralDistance", "teacherEdits"],
      "properties": {
        "engine": {"enum": ["audiveris", "homr", "clarity"]},
        "observationCount": {"type": "integer", "minimum": 1},
        "referenceKinds": {"$ref": "#/$defs/referenceKinds"},
        "musicXmlParseSuccess": {"$ref": "#/$defs/successRate"},
        "structuralValidity": {"$ref": "#/$defs/validityRate"},
        "semanticMetrics": {"$ref": "#/$defs/semanticMetrics"},
        "measureConsistency": {"$ref": "#/$defs/methodMetricAggregate"},
        "relationCorrectness": {"$ref": "#/$defs/methodMetricAggregate"},
        "structuralDistance": {"$ref": "#/$defs/distanceAggregate"},
        "teacherEdits": {"$ref": "#/$defs/teacherEditAggregate"}
      }
    },
    "metricPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singleAggregateAccuracyScore", "engineRanking", "winnerSelection", "tednClaimed", "structuralDistanceMethod", "teacherEditEvidenceMayBeUnavailable"],
      "properties": {
        "singleAggregateAccuracyScore": {"type": "null"},
        "engineRanking": {"const": false},
        "winnerSelection": {"const": false},
        "tednClaimed": {"const": false},
        "structuralDistanceMethod": {"const": "CANONICAL_STRUCTURE_DISTANCE_V1"},
        "teacherEditEvidenceMayBeUnavailable": {"const": true}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["researchEvaluationOnly", "readOnly", "singleAggregateAccuracyScore", "engineRanking", "winnerSelection", "automaticMerge", "automaticCorrection", "teacherApproval", "productionDecisionAuthority", "stOmrIntegration"],
      "properties": {
        "researchEvaluationOnly": {"const": true},
        "readOnly": {"const": true},
        "singleAggregateAccuracyScore": {"const": false},
        "engineRanking": {"const": false},
        "winnerSelection": {"const": false},
        "automaticMerge": {"const": false},
        "automaticCorrection": {"const": false},
        "teacherApproval": {"const": false},
        "productionDecisionAuthority": {"const": false},
        "stOmrIntegration": {"const": false}
      }
    }
  }
}
