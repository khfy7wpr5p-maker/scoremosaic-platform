{
  "version": "scoremosaic-ui-architecture-phase1-v1",
  "workstream": "UI Architecture Phase 1",
  "stageNumberAssigned": false,
  "status": "APPROVED_REPOSITORY_UI_ARCHITECTURE_BASELINE_LOW_FIDELITY_STARTED",
  "parents": [
    "scoremosaic-stage10-ui-experience-eligibility-v1",
    "scoremosaic-stage11-ui-application-eligibility-v1"
  ],
  "purpose": "Define the complete product information architecture, screen architecture, interaction boundaries and design-system structure before high-fidelity Figma work, without activating live APIs or production side effects.",
  "principles": {
    "scoreViewIsPrimaryWorkspace": true,
    "browserIsNotAuthority": true,
    "localEditIntentIsNotScoreEditCommand": true,
    "saveIsNotApproval": true,
    "approvalIsNotPublication": true,
    "rendererIsPresentationOnly": true,
    "statusMeaningCannotBeColorOnly": true,
    "desktopReviewIsPrimary": true,
    "futureModernizationMustPreserveLayerBoundaries": true
  },
  "informationArchitecture": {
    "primaryNavigation": [
      "dashboard",
      "documents",
      "upload",
      "teacher_review",
      "guitar_tab"
    ],
    "secondaryNavigation": [
      "account"
    ],
    "deferredNavigation": [
      "settings",
      "admin",
      "billing"
    ]
  },
  "primaryUserFlow": [
    "dashboard",
    "new_document",
    "input_validation",
    "omr_processing",
    "review_ready",
    "teacher_review",
    "structured_correction",
    "validation",
    "revision",
    "human_approval",
    "publication_eligibility"
  ],
  "screenArchitecture": {
    "dashboard": {
      "purpose": "Action-oriented continuation surface, not an analytics-heavy dashboard.",
      "requiredRegions": ["new_document_action", "needs_review_summary", "processing_summary", "continue_review"]
    },
    "documents": {
      "requiredStates": ["all", "processing", "needs_review", "approved", "published"],
      "requiredCapabilities": ["search", "status_filter", "open_document"]
    },
    "upload": {
      "navigationLabel": "Upload",
      "presentationOnlyUntilLiveGate": true,
      "realFileSubmissionActivated": false,
      "acceptedPresentationTypes": ["pdf", "jpeg", "png"],
      "requiredStates": ["select_input", "validating", "preparing", "processing", "review_ready", "rejected", "unavailable"],
      "liveDependencies": ["authenticated_api", "safe_intake", "object_storage", "job_creation", "omr_gateway"]
    },
    "newDocument": {
      "compatibilityRole": "workflow_name_for_upload_and_processing_flow",
      "presentationOnlyUntilLiveGate": true,
      "requiredStates": ["select_input", "validating", "processing", "review_ready", "rejected", "unavailable"]
    },
    "teacherReview": {
      "navigationLabel": "Teacher Review",
      "requiredRegions": [
        "document_revision_context",
        "issues",
        "score_view",
        "source_evidence",
        "structured_edit",
        "validation_revision_status"
      ],
      "optionalDeferredRegions": ["review_transport"]
    },
    "guitarTab": {
      "navigationLabel": "Guitar TAB",
      "separateWorkspace": true,
      "presentationOnlyUntilLiveGate": true,
      "engineRuntimeActivated": false,
      "sourceBoundary": "validated_or_approved_teacher_review_artifact_only_for_live_integration",
      "requiredRegions": ["standard_notation", "guitar_tab", "fingering_options", "position_playability_evidence"],
      "authority": {
        "mayMutateCanonicalScore": false,
        "mayCreateTeacherRevision": false,
        "mayApprove": false,
        "mayPublish": false
      }
    },
    "revisionHistory": {
      "requiredCapabilities": ["current_revision_identity", "ordered_revision_list", "change_summary", "validation_state"],
      "futureCapability": "revision_compare"
    },
    "approval": {
      "separateFromEditWorkspace": true,
      "requiredEvidence": ["exact_revision", "blocking_issue_count", "validation_state", "corrected_musicxml_identity"]
    },
    "publicationPreparation": {
      "separateFromApproval": true,
      "publishedDoesNotImplyPublic": true,
      "executionActivated": false
    }
  },
  "scoreViewer": {
    "requiredInteractions": [
      "page_navigation",
      "zoom",
      "fit_width",
      "fit_page",
      "measure_focus",
      "event_focus",
      "issue_overlay",
      "score_source_synchronization",
      "keyboard_issue_navigation",
      "staff_voice_context"
    ],
    "rendererAuthoritative": false,
    "selectionAuthoritative": false
  },
  "structuredEdit": {
    "mode": "bounded_musical_controls",
    "rawMusicXmlEditingAllowed": false,
    "directServerMutationAllowed": false,
    "localIntentOnly": true,
    "initialOperationFamilies": [
      "pitch",
      "effective_duration",
      "dots",
      "remove_event"
    ],
    "futureOperationFamiliesRequireContractChange": true
  },
  "validationRevision": {
    "requiredPresentation": [
      "validation_summary",
      "blocking_issue_count",
      "unresolved_issue_count",
      "revision_identity",
      "stale_state"
    ],
    "validationPassImpliesApproval": false,
    "staleRevisionMustFailClosed": true
  },
  "designSystem": {
    "brandRulesContract": "contracts/web-brand-rules-v1.json",
    "foundationsContract": "contracts/design-system-foundations-v1.json",
    "coreComponentsContract": "contracts/design-system-core-components-v1.json",
    "musicDomainComponentsContract": "contracts/design-system-music-domain-components-v1.json",
    "productPatternsContract": "contracts/design-system-product-patterns-v1.json",
    "foundations": ["color_tokens", "typography", "spacing", "grid", "radius", "elevation", "iconography"],
    "coreComponents": [
      "button",
      "input",
      "select",
      "tabs",
      "badge",
      "status",
      "panel",
      "toolbar",
      "dialog",
      "drawer",
      "toast",
      "empty_state",
      "loading_state",
      "validation_message"
    ],
    "musicComponents": [
      "issue_card",
      "score_viewer",
      "measure_marker",
      "issue_marker",
      "evidence_viewer",
      "revision_indicator",
      "structured_edit_field",
      "guitar_tab_viewer",
      "fingering_option_card",
      "playability_evidence"
    ],
    "tokenNamingRequired": true
  },
  "responsiveAccessibility": {
    "minimumRequirements": [
      "keyboard_reachability",
      "visible_focus",
      "programmatic_labels",
      "screen_reader_status_text",
      "no_color_only_semantics",
      "reduced_motion",
      "high_contrast_support",
      "forced_colors_support",
      "score_view_priority_on_narrow_layouts"
    ]
  },
  "changeGovernance": {
    "visualChangesStartAt": "figma_or_design_system",
    "dataRequirementChangesStartAt": "typed_application_contract",
    "transportChangesStartAt": "adapter",
    "authorityOrBusinessRuleChangesStartAt": "server_domain_contract",
    "contractVersioningRequiredForBreakingChanges": true,
    "backwardCompatibilityEvidenceRequired": true
  },
  "figma": {
    "eligibleAfterThisBaseline": true,
    "lowFidelityStarted": true,
    "highFidelityStarted": false,
    "designSystemFoundationsRepositoryReady": true,
    "designSystemFoundationsAppliedInFigma": false,
    "coreComponentArchitectureRepositoryReady": true,
    "coreComponentsAppliedInFigma": false,
    "musicDomainComponentArchitectureRepositoryReady": true,
    "musicDomainComponentsAppliedInFigma": false,
    "productPatternArchitectureRepositoryReady": true,
    "productPatternsAppliedInFigma": false,
    "preFigmaRepositoryArchitectureReady": true,
    "logicalAreas": [
      "00_foundations",
      "01_components",
      "02_patterns",
      "03_dashboard",
      "04_documents",
      "05_upload_processing",
      "06_teacher_review",
      "07_revision",
      "08_approval_publication",
      "09_prototype",
      "10_archive",
      "11_guitar_tab_workspace"
    ],
    "physicalPagePolicy": "starter_plan_three_page_grouping",
    "physicalPages": [
      {
        "name": "00_foundations_components",
        "logicalAreas": ["00_foundations", "01_components", "02_patterns"]
      },
      {
        "name": "01_product_flows",
        "logicalAreas": ["03_dashboard", "04_documents", "05_upload_processing"]
      },
      {
        "name": "02_teacher_review_approval",
        "logicalAreas": ["06_teacher_review", "07_revision", "08_approval_publication", "09_prototype", "10_archive", "11_guitar_tab_workspace"]
      }
    ],
    "logicalAreasMustNotBeDroppedBecauseOfPlanLimits": true,
    "sequence": ["low_fidelity_wireframes", "component_system", "high_fidelity_screens", "clickable_prototype", "design_freeze_v1"]
  },
  "activationLocks": {
    "liveApiActivated": false,
    "realUploadActivated": false,
    "authRuntimeActivated": false,
    "sessionRuntimeActivated": false,
    "rbacRuntimeActivated": false,
    "productionArtifactReadActivated": false,
    "serverWriteActivated": false,
    "approvalExecutionActivated": false,
    "publicationExecutionActivated": false,
    "playbackActivated": false,
    "productionInfrastructureActivated": false
  }
}
