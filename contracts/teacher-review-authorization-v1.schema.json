{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoremosaic.invalid/contracts/teacher-review-authorization-v1.schema.json",
  "title": "ScoreMosaic Teacher Review Authorization Grant v1",
  "description": "Closed, purpose-separated authorization evidence for exact Teacher Review resources. This is not a bearer token and does not activate a public API.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionId", "reviewerId", "tenantId", "jobId", "reviewReportId", "reviewReportSha256", "canonicalScoreSha256", "parentRevisionId", "parentRevisionSha256", "allowedActions", "grantSha256", "signature"],
  "properties": {
    "schemaVersion": {"const": "scoremosaic-review-authz-v1"},
    "decisionId": {"$ref": "#/$defs/id"},
    "reviewerId": {"$ref": "#/$defs/id"},
    "tenantId": {"$ref": "#/$defs/id"},
    "jobId": {"type": "string", "pattern": "^job_[A-Za-z0-9_-]{8,80}$"},
    "reviewReportId": {"$ref": "#/$defs/id"},
    "reviewReportSha256": {"$ref": "#/$defs/sha256"},
    "canonicalScoreSha256": {"$ref": "#/$defs/sha256"},
    "parentRevisionId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "parentRevisionSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "allowedActions": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["revision:read", "revision:propose"]}},
    "grantSha256": {"$ref": "#/$defs/sha256"},
    "signature": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
