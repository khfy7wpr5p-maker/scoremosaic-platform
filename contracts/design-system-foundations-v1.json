{
  "version": "scoremosaic-design-system-foundations-v1",
  "scope": "web_ui_design_system_foundations",
  "parentWorkstream": "scoremosaic-ui-architecture-phase1-v1",
  "brandContract": "contracts/web-brand-rules-v1.json",
  "stageNumberAssigned": false,
  "status": "APPROVED_REPOSITORY_DESIGN_SYSTEM_FOUNDATIONS_BASELINE",
  "principles": {
    "professionalMusicWorkstationDirection": true,
    "scoreViewRemainsPrimaryWorkspace": true,
    "brandColorDoesNotEncodeAuthority": true,
    "statusMeaningCannotRelyOnColorAlone": true,
    "semanticTokensRequired": true,
    "hardcodedScreenSpecificColorsDiscouraged": true,
    "keyboardFocusMustRemainVisible": true,
    "desktopDenseButReadable": true,
    "futureModernizationMustPreserveTokenSemantics": true
  },
  "figmaModePolicy": {
    "currentPlan": "Starter",
    "currentSupportedModesForThisBaseline": ["Light"],
    "darkModeArchitectureRequiredLater": true,
    "darkModeMayBeFakedWithDuplicateHardcodedFrames": false,
    "modeExpansionMustReuseSemanticTokenNames": true
  },
  "primitiveColors": {
    "brand": {
      "navy": "#0B1D3A",
      "blue": "#1D4ED8",
      "teal": "#0EA5A6",
      "violet": "#7C3AED",
      "green": "#22C55E"
    },
    "neutral": {
      "0": "#FFFFFF",
      "25": "#F8FAFC",
      "50": "#F5F7FB",
      "100": "#F1F4F7",
      "200": "#DBE3EC",
      "300": "#C4D0DC",
      "500": "#607086",
      "700": "#334155",
      "900": "#10243E"
    },
    "status": {
      "success": "#177A57",
      "successSoft": "#E9F6EF",
      "warning": "#966317",
      "warningSoft": "#FFF6DF",
      "danger": "#A03945",
      "dangerSoft": "#FFF0F2",
      "focus": "#315FBD"
    }
  },
  "semanticColors": {
    "backgroundCanvas": "neutral.50",
    "backgroundSurface": "neutral.0",
    "backgroundSurfaceMuted": "neutral.25",
    "textPrimary": "neutral.900",
    "textSecondary": "neutral.500",
    "textOnDark": "neutral.0",
    "borderDefault": "neutral.200",
    "borderStrong": "neutral.300",
    "brandPrimary": "brand.teal",
    "brandSecondary": "brand.blue",
    "brandAccentViolet": "brand.violet",
    "statusSuccess": "status.success",
    "statusSuccessSurface": "status.successSoft",
    "statusWarning": "status.warning",
    "statusWarningSurface": "status.warningSoft",
    "statusDanger": "status.danger",
    "statusDangerSurface": "status.dangerSoft",
    "focusRing": "status.focus"
  },
  "legacyPrototypeMigration": {
    "legacyAccent": "#19A7A0",
    "newSemanticBrandPrimary": "brand.teal",
    "migrationIsVisualOnly": true,
    "authoritySemanticsUnchanged": true
  },
  "typography": {
    "family": "Inter",
    "fallback": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "styles": {
      "display": {"fontSize": 40, "lineHeight": 48, "weight": 600},
      "heading1": {"fontSize": 28, "lineHeight": 36, "weight": 600},
      "heading2": {"fontSize": 20, "lineHeight": 28, "weight": 600},
      "title": {"fontSize": 16, "lineHeight": 24, "weight": 600},
      "body": {"fontSize": 14, "lineHeight": 20, "weight": 400},
      "bodyStrong": {"fontSize": 14, "lineHeight": 20, "weight": 600},
      "label": {"fontSize": 12, "lineHeight": 16, "weight": 600},
      "micro": {"fontSize": 11, "lineHeight": 16, "weight": 600}
    },
    "wordmarkUsesUiTypography": false
  },
  "spacing": {
    "0": 0,
    "50": 4,
    "100": 8,
    "150": 12,
    "200": 16,
    "250": 20,
    "300": 24,
    "400": 32,
    "500": 40,
    "600": 48,
    "800": 64
  },
  "radius": {
    "xs": 4,
    "sm": 8,
    "control": 9,
    "md": 12,
    "panel": 14,
    "pill": 999
  },
  "elevation": {
    "none": {"x": 0, "y": 0, "blur": 0, "spread": 0, "color": "#00000000"},
    "panel": {"x": 0, "y": 8, "blur": 24, "spread": 0, "color": "#10243E14"},
    "floating": {"x": 0, "y": 14, "blur": 36, "spread": 0, "color": "#10243E1F"}
  },
  "interaction": {
    "visualControlHeightsPx": [32, 36, 40],
    "minimumPointerHitTargetPx": 44,
    "focusOutlinePx": 3,
    "focusOutlineOffsetPx": 2,
    "disabledStateMustNotRelyOnOpacityAlone": true,
    "hoverStateMustNotBeOnlyIndicatorOfActionability": true
  },
  "layout": {
    "appHeaderMinHeightPx": 72,
    "workspaceGapPx": 14,
    "workspaceOuterPaddingPx": 14,
    "teacherReviewColumns": ["issues", "score_and_evidence", "structured_edit"],
    "scoreColumnMustRemainLargest": true,
    "narrowLayoutMustPrioritizeScoreView": true
  },
  "iconography": {
    "style": "clean_geometric_outline_with_filled_state_when_semantically_required",
    "minimumStandaloneIconPx": 16,
    "defaultToolbarIconPx": 18,
    "iconOnlyControlsRequireAccessibleLabel": true,
    "decorativeIconsMayNotCarryStatusMeaningAlone": true
  },
  "componentReadinessOrder": [
    "button",
    "icon_button",
    "tabs",
    "status_badge",
    "panel",
    "input",
    "toolbar",
    "issue_card",
    "validation_status",
    "revision_indicator"
  ],
  "tokenNaming": {
    "primitivePrefix": "primitive",
    "semanticPrefix": "color_or_space_or_radius_or_type_or_elevation",
    "screenSpecificTokenNamesAllowed": false,
    "examples": [
      "color.background.canvas",
      "color.text.primary",
      "color.status.danger",
      "space.200",
      "radius.panel",
      "type.body",
      "elevation.panel"
    ]
  },
  "figmaRequirements": {
    "primitiveVariablesBeforeSemanticVariables": true,
    "semanticColorsAliasPrimitives": true,
    "allVariableScopesExplicit": true,
    "webCodeSyntaxRequired": true,
    "textStylesRequired": true,
    "effectStylesRequired": true,
    "componentsMayNotPrecedeFoundations": true,
    "visualQaRequiredBeforeHighFidelity": true
  },
  "activationLocks": {
    "highFidelityScreenImplementationActivatedByThisContract": false,
    "liveApiActivated": false,
    "realUploadActivated": false,
    "serverWriteActivated": false,
    "approvalExecutionActivated": false,
    "publicationExecutionActivated": false,
    "productionInfrastructureActivated": false
  }
}
