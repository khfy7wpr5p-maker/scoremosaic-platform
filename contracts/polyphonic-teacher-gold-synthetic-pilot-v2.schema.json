{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoremosaic.dev/contracts/polyphonic-teacher-gold-synthetic-pilot-v2.schema.json",
  "title": "ScoreMosaic Teacher-Gold Synthetic Pilot v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataset", "sourceRepository", "sourceCommitSha", "license", "renderer", "reviewImageProcessing", "discoveryEvidence", "supersedes", "pilotCount", "records", "boundaries"],
  "properties": {
    "schemaVersion": {"const": "scoremosaic-polyphonic-teacher-gold-synthetic-pilot-v2"},
    "dataset": {"const": "OSSQ-OMR"},
    "sourceRepository": {"const": "MALerLab/ossq-omr"},
    "sourceCommitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license": {"const": "CC0-1.0"},
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "versionOutput", "releaseTag", "appImageSha256", "imageResolutionDpi"],
      "properties": {
        "name": {"const": "MuseScore"},
        "versionOutput": {"const": "MuseScore: Music Score Editor; Version 3.6.2; Build 3224f34"},
        "releaseTag": {"const": "v3.6.2"},
        "appImageSha256": {"const": "c59a41ee88bc7c565a939b9c73498ac0451bbd86574e95cb6e359302c1465290"},
        "imageResolutionDpi": {"const": 150}
      }
    },
    "reviewImageProcessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "versionOutput", "background", "alphaRemoved", "validationMethod"],
      "properties": {
        "tool": {"const": "ImageMagick"},
        "versionOutput": {"const": "Version: ImageMagick 6.9.12-98 Q16 x86_64 18038 https://legacy.imagemagick.org"},
        "background": {"const": "#FFFFFF"},
        "alphaRemoved": {"const": true},
        "validationMethod": {"const": "OPAQUE_NONEMPTY_PAGE_V1"}
      }
    },
    "discoveryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowRunId", "workflowHeadSha", "artifactId", "artifactZipSha256", "artifactRetentionDays"],
      "properties": {
        "workflowRunId": {"const": 34883487564},
        "workflowHeadSha": {"const": "97cdded35aa401ae74f7959d21ddfcf1546ab7b9"},
        "artifactId": {"const": 10363841418},
        "artifactZipSha256": {"const": "7815fe6c144e1b85e13c994879ff78aa57c78846be2a8f1f504cb22ea95b6b7d"},
        "artifactRetentionDays": {"const": 14}
      }
    },
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "manifestPath", "artifactId", "reason", "reviewUseAuthorized"],
      "properties": {
        "schemaVersion": {"const": "scoremosaic-polyphonic-teacher-gold-synthetic-pilot-v1"},
        "manifestPath": {"const": "evaluation/polyphonic-teacher-gold-v1/pilots/ossq-synthetic-v1.json"},
        "artifactId": {"const": 10362957231},
        "reason": {"const": "TRANSPARENT_REVIEW_RENDER_UNREADABLE_ON_DARK_PREVIEW"},
        "reviewUseAuthorized": {"const": false}
      }
    },
    "pilotCount": {"const": 5},
    "records": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pilotId", "title", "sourcePath", "symbolicGold", "renderedEvidence", "rightsStatus", "teacherVerificationStatus", "evaluationEligibility", "countTowardTeacherGoldMinimum"],
        "properties": {
          "pilotId": {"type": "string", "pattern": "^ossq_[0-9]{7,8}$"},
          "title": {"type": "string", "minLength": 3, "maxLength": 200},
          "sourcePath": {"type": "string", "pattern": "^scores/.+\\.musicxml$", "maxLength": 300},
          "symbolicGold": {"$ref": "#/$defs/musicXmlArtifact"},
          "renderedEvidence": {"$ref": "#/$defs/pngArtifact"},
          "rightsStatus": {"const": "CLEAR_CC0"},
          "teacherVerificationStatus": {"const": "DRAFT"},
          "evaluationEligibility": {"const": "REVIEW_REQUIRED"},
          "countTowardTeacherGoldMinimum": {"const": false}
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["researchEvaluationOnly", "teacherVerified", "automaticFixtureAdmission", "automaticTrainingAuthorization", "productionDecisionAuthority"],
      "properties": {
        "researchEvaluationOnly": {"const": true},
        "teacherVerified": {"const": false},
        "automaticFixtureAdmission": {"const": false},
        "automaticTrainingAuthorization": {"const": false},
        "productionDecisionAuthority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "musicXmlArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "sha256", "byteSize"],
      "properties": {
        "mediaType": {"const": "application/vnd.recordare.musicxml+xml"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byteSize": {"type": "integer", "minimum": 1, "maximum": 20000000}
      }
    },
    "pngArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "page", "sha256", "byteSize", "background", "alphaChannel"],
      "properties": {
        "mediaType": {"const": "image/png"},
        "page": {"const": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byteSize": {"type": "integer", "minimum": 1, "maximum": 20000000},
        "background": {"const": "#FFFFFF"},
        "alphaChannel": {"const": false}
      }
    }
  }
}
