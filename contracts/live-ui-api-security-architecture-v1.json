{
  "version": "scoremosaic-live-ui-api-security-architecture-v1",
  "workstream": "Live UI <-> API Security Architecture",
  "stageNumberAssigned": false,
  "status": "APPROVED_REPOSITORY_LIVE_UI_API_SECURITY_ARCHITECTURE_BASELINE",
  "scope": "repository_only_security_architecture_no_runtime_activation",
  "parents": [
    "scoremosaic-stage11-ui-application-eligibility-v1",
    "scoremosaic-ui-architecture-phase1-v1"
  ],
  "principles": {
    "browserIsNotAuthority": true,
    "serverAuthorizesEveryProtectedRequest": true,
    "clientClaimsAreNotAuthorization": true,
    "transportDoesNotCreateDomainAuthority": true,
    "denyByDefault": true,
    "sameOriginByDefault": true,
    "credentialsNeverStoredInBrowserPersistence": true,
    "identityProviderTokensNeverExposedToApplicationJavascript": true,
    "exactCurrentRevisionRequiredForMutation": true,
    "oldValuePreconditionRequiredForScoreMutation": true,
    "staleMutationFailsClosed": true,
    "automaticAmbiguousMutationRetryForbidden": true,
    "privacySafeErrorsAndLogsRequired": true,
    "liveActivationRequiresSeparateRuntimeGate": true
  },
  "identityAndSession": {
    "targetIdentityProvider": "Authentik",
    "protocol": "OIDC_OAUTH2",
    "flow": "authorization_code_with_pkce",
    "termination": "server_side_bff_or_equivalent_confidential_boundary",
    "browserReceivesProviderAccessToken": false,
    "browserReceivesProviderRefreshToken": false,
    "browserStoresSessionInLocalStorage": false,
    "browserStoresSessionInSessionStorage": false,
    "sessionCookie": {
      "name": "__Host-scoremosaic_session",
      "httpOnly": true,
      "secure": true,
      "sameSite": "Lax",
      "path": "/",
      "domainAttributeAllowed": false,
      "boundedIdleExpiryRequired": true,
      "boundedAbsoluteExpiryRequired": true,
      "rotationAfterAuthenticationRequired": true,
      "serverSideInvalidationOnLogoutRequired": true
    },
    "sessionValuesMayGrantTenantOrResourceAuthorityByThemselves": false
  },
  "authorization": {
    "principalResolvedServerSide": true,
    "tenantMembershipResolvedServerSide": true,
    "resourceAuthorizationResolvedServerSide": true,
    "idpRoleClaimAloneSufficientForResourceAccess": false,
    "exactDocumentScopeRequired": true,
    "exactRevisionScopeRequiredWhereApplicable": true,
    "crossTenantAccessDeniedByDefault": true,
    "unknownResourceAccessFailsClosed": true,
    "hiddenOrDisabledUiActionCountsAsAuthorization": false,
    "operationAuthorizationMustBeRecheckedOnEveryProtectedRequest": true
  },
  "apiTransport": {
    "basePath": "/api/v1",
    "httpsRequiredForRuntime": true,
    "sameOriginApplicationApiPreferred": true,
    "browserMaySupplyArbitraryApiOrigin": false,
    "contentType": "application/json",
    "versionedSchemasRequired": true,
    "boundedRequestBodiesRequired": true,
    "serverCanonicalCorrelationIdRequired": true,
    "clientRequestIdMayBeAcceptedAsNonAuthoritativeCorrelationInput": true,
    "clientRequestIdMayBecomeCommandOrRevisionIdentity": false,
    "initialReadEndpoints": [
      {
        "operation": "review.read",
        "method": "GET",
        "pathTemplate": "/api/v1/documents/{document_id}/revisions/{revision_id}/review"
      },
      {
        "operation": "issues.read",
        "method": "GET",
        "pathTemplate": "/api/v1/documents/{document_id}/revisions/{revision_id}/issues"
      },
      {
        "operation": "sourceEvidence.read",
        "method": "GET",
        "pathTemplate": "/api/v1/documents/{document_id}/revisions/{revision_id}/source-evidence"
      },
      {
        "operation": "validation.read",
        "method": "GET",
        "pathTemplate": "/api/v1/documents/{document_id}/revisions/{revision_id}/validation"
      }
    ],
    "localEditIntentPrepareIsServerEndpoint": false,
    "mutationEndpointCatalogRequiresTeacherReviewApiContract": true
  },
  "csrfOriginCors": {
    "stateChangingMethods": ["POST", "PUT", "PATCH", "DELETE"],
    "sessionBoundCsrfTokenRequiredForStateChange": true,
    "exactAllowedOriginCheckRequiredForStateChange": true,
    "missingOrInvalidCsrfFailsClosed": true,
    "wildcardCorsWithCredentialsAllowed": false,
    "credentialedCrossOriginApiAllowedByDefault": false,
    "sameOriginRequestsNeedCorsEnablement": false,
    "crossOriginExpansionRequiresVersionedContractChange": true
  },
  "contentSecurityPolicy": {
    "currentDisconnectedConnectSrc": "'none'",
    "futureLiveApiConnectSrcMaximumBaseline": "'self'",
    "futureConnectSrcMayActivateBeforeRuntimeGate": false,
    "scriptSrcRequiresRepositoryOrBuiltApplicationAssets": true,
    "objectSrc": "'none'",
    "baseUri": "'none'",
    "frameAncestors": "'none'",
    "unsafeEvalAllowed": false,
    "unsafeInlineScriptAllowedByDefault": false
  },
  "mutationSafety": {
    "scoreMutationRequiresAuthenticatedPrincipal": true,
    "scoreMutationRequiresAuthorizedResource": true,
    "scoreMutationRequiresExactCurrentParentRevision": true,
    "scoreMutationRequiresStableTargetIdentity": true,
    "scoreMutationRequiresOldValuePrecondition": true,
    "scoreMutationRequiresClosedOperationVocabulary": true,
    "browserLocalIntentIsScoreEditCommand": false,
    "serverMustCreateOrValidateCommandIdentity": true,
    "validationPassMayAutoApprove": false,
    "approvalMayAutoPublish": false
  },
  "idempotencyAndRetry": {
    "mutationIdempotencyRequired": true,
    "idempotencyKeyIsOpaqueRetryTokenNotDomainIdentity": true,
    "idempotencyScopeIncludes": [
      "authenticated_principal",
      "tenant",
      "operation",
      "resource",
      "exact_parent_revision",
      "request_digest"
    ],
    "sameKeySameDigestReturnsSameCommittedOutcome": true,
    "sameKeyDifferentDigestRejected": true,
    "browserAutomaticMutationRetryAllowed": false,
    "ambiguousMutationOutcomeRequiresReconciliation": true,
    "safeReadRetryMayUseBoundedBackoff": true,
    "retryPolicyMustRespectServerRetryAfter": true
  },
  "errorModel": {
    "stableErrorCodeRequired": true,
    "correlationIdRequired": true,
    "retryabilityMustBeExplicitWhenKnown": true,
    "rawExceptionTextExposed": false,
    "credentialsOrTokensExposed": false,
    "sourceDocumentContentExposed": false,
    "fullMusicXmlExposed": false,
    "unrestrictedLocalPathExposed": false,
    "crossResourceExistenceDisclosureForbidden": true
  },
  "audit": {
    "appendOnlyEvidenceRequired": true,
    "serverTimestampRequired": true,
    "principalIdentityRequired": true,
    "tenantIdentityRequiredWhereApplicable": true,
    "operationRequired": true,
    "resourceIdentityRequired": true,
    "revisionIdentityRequiredWhereApplicable": true,
    "outcomeRequired": true,
    "correlationIdRequired": true,
    "rawSessionTokenLogged": false,
    "rawCsrfTokenLogged": false,
    "rawIdempotencyKeyLogged": false,
    "privacySafeErrorCategoryRequired": true
  },
  "rateLimitAndAbuse": {
    "serverSideRateLimitsRequired": true,
    "principalAndTenantAwareWhereApplicable": true,
    "networkSourceMayBeDefenseInDepthSignal": true,
    "exactLimitsAreDeploymentConfiguration": true,
    "rateLimitMayGrantAuthorization": false,
    "mutationRateLimitFailureMayTriggerAutomaticReplay": false
  },
  "rollbackAndKillSwitch": {
    "liveUiApiTransportCanBeDisabledIndependently": true,
    "mutationTransportCanBeDisabledIndependently": true,
    "readTransportCanBeDisabledIndependently": true,
    "cspCanReturnToConnectSrcNone": true,
    "authFailureMustFailClosed": true,
    "killSwitchMayBypassAuthorization": false,
    "rollbackMustNotRollBackImmutableTeacherRevisionHistory": true
  },
  "negativeSecurityCoverage": [
    "missing_session",
    "expired_session",
    "forged_session",
    "cross_tenant_document_access",
    "cross_resource_revision_access",
    "browser_supplied_role_escalation",
    "missing_csrf",
    "invalid_csrf",
    "wrong_origin",
    "wildcard_cors_credentials_attempt",
    "stale_revision_mutation",
    "old_value_precondition_mismatch",
    "unstable_or_unknown_target_identity",
    "duplicate_idempotency_key_same_payload",
    "duplicate_idempotency_key_different_payload",
    "ambiguous_write_retry_attempt",
    "client_request_id_authority_escalation",
    "error_detail_secret_leak_attempt",
    "audit_token_leak_attempt",
    "direct_browser_omr_engine_call",
    "direct_browser_downstream_engine_call"
  ],
  "runtimePrerequisites": {
    "teacherReviewApiContractRequired": true,
    "productionOriginAndDomainRequired": true,
    "tlsEvidenceRequired": true,
    "authentikRuntimeConfigurationRequired": true,
    "productionSecretProvisioningRequired": true,
    "productionDatabaseAndArtifactPersistenceEvidenceRequired": true,
    "negativeSecurityTestsRequired": true,
    "endToEndSecurityTestsRequired": true,
    "rollbackExerciseRequired": true,
    "separateReviewedActivationDecisionRequired": true
  },
  "activationLocks": {
    "liveNetworkActivated": false,
    "connectSrcSelfActivated": false,
    "authRuntimeActivated": false,
    "sessionRuntimeActivated": false,
    "rbacRuntimeActivated": false,
    "productionArtifactReadActivated": false,
    "teacherReviewServerWriteActivated": false,
    "scoreEditCommandCreationActivated": false,
    "teacherScoreRevisionCreationActivated": false,
    "approvalExecutionActivated": false,
    "publicationExecutionActivated": false,
    "realUploadActivated": false,
    "productionInfrastructureActivated": false,
    "publicTrafficActivated": false
  }
}
