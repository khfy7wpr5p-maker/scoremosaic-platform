{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scoremosaic-stage11-read-request-v1",
  "title": "ScoreMosaic Stage 11 read request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "kind", "documentId", "revision"],
  "properties": {
    "schemaVersion": {"const": "scoremosaic-stage11-read-request-v1"},
    "requestId": {"$ref": "#/$defs/requestId"},
    "kind": {"enum": ["review.read", "issues.read", "sourceEvidence.read", "validation.read"]},
    "documentId": {"$ref": "#/$defs/resourceId"},
    "revision": {"$ref": "#/$defs/resourceId"}
  },
  "$defs": {
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "resourceId": {"type": "string", "minLength": 1, "maxLength": 160}
  }
}
