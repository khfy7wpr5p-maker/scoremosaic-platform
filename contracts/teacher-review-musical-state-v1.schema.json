{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoremosaic.invalid/contracts/teacher-review-musical-state-v1.schema.json",
  "title": "ScoreMosaic Teacher Review Musical State v1",
  "description": "Deterministic Canonical-derived review state. This is not corrected MusicXML and is never approval/publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseCanonicalSha256", "parts", "stateSha256"],
  "properties": {
    "schemaVersion": {"const": "scoremosaic-review-musical-state-v1"},
    "baseCanonicalSha256": {"$ref": "#/$defs/sha256"},
    "parts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/part"}},
    "stateSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "rational": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1, "maximum": 1000000}}
    },
    "timeSignature": {
      "type": "object", "additionalProperties": false,
      "required": ["beats", "beatType"],
      "properties": {"beats": {"type": "string", "pattern": "^[1-9][0-9]*(\\+[1-9][0-9]*)*$", "maxLength": 40}, "beatType": {"type": "integer", "minimum": 1, "maximum": 1024}}
    },
    "part": {
      "type": "object", "additionalProperties": false,
      "required": ["partId", "ordinal", "measures"],
      "properties": {"partId": {"$ref": "#/$defs/id"}, "ordinal": {"type": "integer", "minimum": 1}, "measures": {"type": "array", "minItems": 1, "maxItems": 20000, "items": {"$ref": "#/$defs/measure"}}}
    },
    "measure": {
      "type": "object", "additionalProperties": false,
      "required": ["measureId", "number", "ordinal", "implicit", "timeSignatureAtStart", "expectedDuration", "observedDuration", "timeSignatureChanges", "events"],
      "properties": {
        "measureId": {"$ref": "#/$defs/id"}, "number": {"type": "string", "minLength": 1, "maxLength": 40},
        "ordinal": {"type": "integer", "minimum": 1}, "implicit": {"type": "boolean"},
        "timeSignatureAtStart": {"oneOf": [{"$ref": "#/$defs/timeSignature"}, {"type": "null"}]},
        "expectedDuration": {"oneOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]},
        "observedDuration": {"$ref": "#/$defs/rational"},
        "timeSignatureChanges": {"type": "array", "maxItems": 500000},
        "events": {"type": "array", "maxItems": 500000, "items": {"$ref": "#/$defs/event"}}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["eventId", "xmlOrder", "kind", "onset", "effectiveDuration", "writtenDuration", "writtenType", "dots", "tuplet", "voice", "staff", "pitch", "tab", "grace", "chordGroup", "chordIndex", "ties", "provenance"],
      "properties": {
        "eventId": {"$ref": "#/$defs/id"}, "xmlOrder": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["note", "rest", "unpitched"]}, "onset": {"$ref": "#/$defs/rational"},
        "effectiveDuration": {"$ref": "#/$defs/rational"},
        "writtenDuration": {"oneOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]},
        "writtenType": {"type": ["string", "null"], "maxLength": 40}, "dots": {"type": "integer", "minimum": 0, "maximum": 8},
        "tuplet": {"oneOf": [{"$ref": "#/$defs/tuplet"}, {"type": "null"}]}, "voice": {"type": "string", "minLength": 1, "maxLength": 40},
        "staff": {"type": "integer", "minimum": 1, "maximum": 128}, "pitch": {"oneOf": [{"$ref": "#/$defs/pitch"}, {"type": "null"}]},
        "tab": {"oneOf": [{"$ref": "#/$defs/tab"}, {"type": "null"}]}, "grace": {"type": "boolean"},
        "chordGroup": {"type": ["string", "null"], "maxLength": 200}, "chordIndex": {"type": ["integer", "null"], "minimum": 0},
        "ties": {"type": "array", "uniqueItems": true, "items": {"enum": ["continue", "start", "stop"]}},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "pitch": {"type": "object", "additionalProperties": false, "required": ["step", "alter", "octave"], "properties": {"step": {"enum": ["A", "B", "C", "D", "E", "F", "G"]}, "alter": {"$ref": "#/$defs/rational"}, "octave": {"type": "integer", "minimum": -2, "maximum": 12}}},
    "tab": {"type": "object", "additionalProperties": false, "required": ["string", "fret"], "properties": {"string": {"type": "integer", "minimum": 1, "maximum": 24}, "fret": {"type": "integer", "minimum": 0, "maximum": 96}}},
    "tuplet": {"type": "object", "additionalProperties": false, "required": ["actualNotes", "normalNotes"], "properties": {"actualNotes": {"type": "integer", "minimum": 1, "maximum": 1024}, "normalNotes": {"type": "integer", "minimum": 1, "maximum": 1024}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["xmlPath", "sourceEventIndex"], "properties": {"xmlPath": {"type": "string", "minLength": 1, "maxLength": 1000}, "sourceEventIndex": {"type": "integer", "minimum": 0}}}
  }
}
