{
  "version": "scoremosaic-stage9-service-identity-secrets-v1",
  "stage": "9-C",
  "baselineRef": "scoremosaic-stage9-production-foundation-baseline-v1",
  "topologyRef": "scoremosaic-stage9-resource-topology-v1",
  "status": "REPOSITORY_ONLY_IDENTITY_AND_SECRET_POLICY_WITH_RUNTIME_LOCKS",
  "secretManager": {
    "target": "infisical",
    "selfHostedTarget": true,
    "coolifyRole": "minimal-bootstrap-only",
    "paidCapabilitiesAssumed": false,
    "licensingCapabilityGateRequired": true
  },
  "environmentPolicy": {
    "environments": ["development", "staging", "production"],
    "crossEnvironmentReadAllowed": false,
    "crossEnvironmentWriteAllowed": false,
    "productionSecretsUsableInCi": false,
    "productionSecretsUsableInDevelopment": false,
    "sharedProductionMachineIdentityAllowed": false
  },
  "rotationPolicy": {
    "generationIdentityRequired": true,
    "boundedCurrentAndPreviousOverlapAllowed": true,
    "unboundedGracePeriodAllowed": false,
    "revokedGenerationMayAuthenticate": false,
    "rotationMayWidenSecretScope": false,
    "rotationEvidenceRequiredBeforePromotion": true
  },
  "serviceIdentities": [
    {
      "service": "scoremosaic-application",
      "secretClasses": [
        "application-database-role",
        "authentik-oidc-client",
        "application-object-storage-readwrite",
        "application-signing-material"
      ],
      "forbiddenSecretClasses": [
        "database-admin",
        "provider-account-admin",
        "omr-dispatch-all-engines",
        "publication-object-delete",
        "infisical-root"
      ]
    },
    {
      "service": "gateway-orchestrator",
      "secretClasses": [
        "gateway-engine-dispatch-purpose-separated",
        "gateway-result-verification-purpose-separated",
        "source-artifact-read"
      ],
      "forbiddenSecretClasses": [
        "database-admin",
        "publication-write",
        "provider-account-admin",
        "infisical-root"
      ]
    },
    {
      "service": "omr-compute",
      "secretClasses": [
        "engine-specific-receiver-identity",
        "engine-specific-result-return"
      ],
      "forbiddenSecretClasses": [
        "database-admin",
        "application-database-role",
        "publication-write",
        "provider-account-admin",
        "other-engine-identity",
        "infisical-root"
      ]
    },
    {
      "service": "publication-service",
      "secretClasses": [
        "publication-database-role",
        "published-object-write",
        "publication-signing-material"
      ],
      "forbiddenSecretClasses": [
        "database-admin",
        "source-object-delete",
        "omr-dispatch-all-engines",
        "provider-account-admin",
        "infisical-root"
      ]
    },
    {
      "service": "backup-worker",
      "secretClasses": [
        "database-backup-role",
        "primary-object-read",
        "secondary-backup-object-write"
      ],
      "forbiddenSecretClasses": [
        "database-admin",
        "publication-signing-material",
        "user-authentication-admin",
        "source-object-delete",
        "provider-account-admin",
        "infisical-root"
      ]
    },
    {
      "service": "authentik-identity",
      "secretClasses": [
        "authentik-database-role",
        "authentik-service-encryption",
        "authentik-provider-client-bootstrap"
      ],
      "forbiddenSecretClasses": [
        "scoremosaic-resource-authorization",
        "publication-signing-material",
        "database-admin",
        "provider-account-admin",
        "infisical-root"
      ]
    },
    {
      "service": "infisical-secrets",
      "secretClasses": ["infisical-self-host-bootstrap"],
      "forbiddenSecretClasses": [
        "scoremosaic-user-data",
        "scoremosaic-musical-authority",
        "provider-account-admin"
      ]
    },
    {
      "service": "coolify-control-plane",
      "secretClasses": ["infisical-bootstrap-reference"],
      "forbiddenSecretClasses": [
        "general-application-secret-store",
        "database-admin",
        "provider-account-admin",
        "publication-signing-material",
        "omr-dispatch-all-engines"
      ]
    }
  ],
  "bootstrapPolicy": {
    "repositoryMayContainSecretValues": false,
    "browserMayReceiveMachineSecrets": false,
    "logsMayContainSecretValues": false,
    "coolifyMayActAsGeneralProductionSecretStore": false,
    "bootstrapMaterialMustBeMinimal": true,
    "bootstrapMaterialMustBeRotatable": true,
    "bootstrapMaterialMustBeRecoverableWithoutApplicationDataAccess": true
  },
  "authorizationPolicy": {
    "authenticationIdentityMayImplyMusicalAuthorization": false,
    "machineIdentityMayImplyTenantAuthorization": false,
    "secretPossessionAloneMayGrantPublicationAuthority": false,
    "purposeSeparatedCredentialRequired": true,
    "wildcardSecretScopeAllowed": false,
    "leastPrivilegeRequired": true
  },
  "activationLocks": {
    "machineIdentitiesCreated": false,
    "productionSecretsGenerated": false,
    "productionSecretsProvisioned": false,
    "coolifyProductionBootstrapConfigured": false,
    "infisicalProductionRuntimeActivated": false,
    "rotationRuntimeActivated": false,
    "revocationRuntimeActivated": false,
    "providerCredentialsProvisioned": false,
    "databaseCredentialsProvisioned": false,
    "objectStorageCredentialsProvisioned": false,
    "oidcClientCredentialsProvisioned": false,
    "publicationCredentialsProvisioned": false,
    "omrDispatchCredentialsProvisioned": false
  }
}
