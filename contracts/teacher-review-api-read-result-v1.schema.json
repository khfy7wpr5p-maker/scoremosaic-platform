{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoremosaic.invalid/contracts/teacher-review-api-read-result-v1.schema.json",
  "title": "ScoreMosaic Teacher Review API Read Result v1",
  "description": "Closed live-API read result for the four Stage 11 Teacher Review read operations. Server correlation is mandatory; client request identity is optional and non-authoritative. Error states expose no resolved document/revision data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "correlationId",
    "operation",
    "state",
    "documentId",
    "revisionId",
    "data",
    "error",
    "authority"
  ],
  "properties": {
    "schemaVersion": {"const": "scoremosaic-teacher-review-api-read-result-v1"},
    "requestId": {
      "oneOf": [
        {"type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,120}$"},
        {"type": "null"}
      ]
    },
    "correlationId": {
      "type": "string",
      "pattern": "^corr_[A-Za-z0-9_-]{8,120}$"
    },
    "operation": {
      "enum": ["review.read", "issues.read", "sourceEvidence.read", "validation.read"]
    },
    "state": {"enum": ["success", "empty", "rejected", "unavailable"]},
    "documentId": {
      "oneOf": [
        {"$ref": "#/$defs/id"},
        {"type": "null"}
      ]
    },
    "revisionId": {
      "oneOf": [
        {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        {"type": "null"}
      ]
    },
    "data": {
      "oneOf": [
        {"$ref": "stage11-read-response-v1.schema.json#/$defs/reviewData"},
        {"$ref": "stage11-read-response-v1.schema.json#/$defs/issuesData"},
        {"$ref": "stage11-read-response-v1.schema.json#/$defs/sourceEvidenceData"},
        {"$ref": "stage11-read-response-v1.schema.json#/$defs/validationData"},
        {"type": "null"}
      ]
    },
    "error": {
      "oneOf": [
        {"$ref": "#/$defs/error"},
        {"type": "null"}
      ]
    },
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 500},
        "retryable": {"type": "boolean"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative", "canMutate", "canApprove", "canPublish"],
      "properties": {
        "authoritative": {"const": false},
        "canMutate": {"const": false},
        "canApprove": {"const": false},
        "canPublish": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "success"}}, "required": ["state"]},
      "then": {
        "properties": {
          "documentId": {"$ref": "#/$defs/id"},
          "revisionId": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
          "error": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"state": {"enum": ["rejected", "unavailable"]}},
        "required": ["state"]
      },
      "then": {
        "properties": {
          "documentId": {"type": "null"},
          "revisionId": {"type": "null"},
          "data": {"type": "null"},
          "error": {"$ref": "#/$defs/error"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "empty"}}, "required": ["state"]},
      "then": {
        "properties": {
          "documentId": {"$ref": "#/$defs/id"},
          "revisionId": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
          "data": {"type": "null"},
          "error": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "review.read"}, "state": {"const": "success"}}, "required": ["operation", "state"]},
      "then": {"properties": {"data": {"$ref": "stage11-read-response-v1.schema.json#/$defs/reviewData"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "issues.read"}, "state": {"const": "success"}}, "required": ["operation", "state"]},
      "then": {"properties": {"data": {"$ref": "stage11-read-response-v1.schema.json#/$defs/issuesData"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "sourceEvidence.read"}, "state": {"const": "success"}}, "required": ["operation", "state"]},
      "then": {"properties": {"data": {"$ref": "stage11-read-response-v1.schema.json#/$defs/sourceEvidenceData"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "validation.read"}, "state": {"const": "success"}}, "required": ["operation", "state"]},
      "then": {"properties": {"data": {"$ref": "stage11-read-response-v1.schema.json#/$defs/validationData"}}}
    }
  ]
}
