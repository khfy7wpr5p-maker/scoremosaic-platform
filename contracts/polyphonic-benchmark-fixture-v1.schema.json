{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoremosaic.local/contracts/polyphonic-benchmark-fixture-v1.schema.json",
  "title": "ScoreMosaic Polyphonic Teacher-Gold Benchmark Fixture v1",
  "description": "Research/evaluation-only metadata contract for one page, system, or measure fixture. Teacher-gold identity is separated from engine outputs and teacher correction does not imply training authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "granularity",
    "location",
    "source",
    "gold",
    "classification",
    "boundaries"
  ],
  "properties": {
    "schemaVersion": {"const": "scoremosaic-polyphonic-benchmark-fixture-v1"},
    "fixtureId": {"type": "string", "pattern": "^poly_fixture_[A-Za-z0-9_-]{8,96}$"},
    "granularity": {"enum": ["page", "system", "measure"]},
    "location": {"$ref": "#/$defs/location"},
    "source": {"$ref": "#/$defs/source"},
    "gold": {"$ref": "#/$defs/gold"},
    "classification": {"$ref": "#/$defs/classification"},
    "expectedErrorFocus": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 22,
      "items": {"$ref": "#/$defs/errorCode"}
    },
    "boundaries": {"$ref": "#/$defs/boundaries"}
  },
  "allOf": [
    {
      "if": {"properties": {"granularity": {"const": "system"}}},
      "then": {
        "properties": {
          "location": {
            "required": ["pageIndex", "systemId"],
            "properties": {
              "pageIndex": {},
              "systemId": {}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"granularity": {"const": "measure"}}},
      "then": {
        "properties": {
          "location": {
            "required": ["pageIndex", "systemId", "measureId"],
            "properties": {
              "pageIndex": {},
              "systemId": {},
              "measureId": {}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "safeRef": {"type": "string", "minLength": 1, "maxLength": 500},
    "errorCode": {
      "enum": [
        "PITCH",
        "DURATION",
        "ONSET",
        "VOICE",
        "STAFF",
        "REST",
        "ACCIDENTAL",
        "TIE",
        "SLUR",
        "TUPLET",
        "BEAM",
        "STEM",
        "CHORD_GROUPING",
        "CROSS_STAFF",
        "METER",
        "MEASURE_BOUNDARY",
        "GRACE",
        "ORNAMENT",
        "DOT",
        "TAB_POSITION",
        "OTHER",
        "AMBIGUOUS"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageIndex"],
      "properties": {
        "pageIndex": {"type": "integer", "minimum": 0, "maximum": 10000},
        "systemId": {"$ref": "#/$defs/safeId"},
        "measureId": {"$ref": "#/$defs/safeId"},
        "staffIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/safeId"}
        }
      }
    },
    "licenseMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "version",
        "source",
        "license",
        "redistributionStatus",
        "trainingAllowed",
        "evaluationAllowed",
        "commercialUseImplications"
      ],
      "properties": {
        "dataset": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "source": {"$ref": "#/$defs/safeRef"},
        "license": {"type": "string", "minLength": 1, "maxLength": 300},
        "redistributionStatus": {"enum": ["ALLOWED", "NOT_ALLOWED", "REVIEW_REQUIRED"]},
        "trainingAllowed": {"enum": ["YES", "NO", "REVIEW_REQUIRED"]},
        "evaluationAllowed": {"enum": ["YES", "NO", "REVIEW_REQUIRED"]},
        "commercialUseImplications": {"enum": ["ALLOWED", "NONCOMMERCIAL_ONLY", "REVIEW_REQUIRED", "UNKNOWN"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceSha256",
        "mediaType",
        "originType",
        "assetAvailability",
        "sourceReference",
        "licenseMetadata"
      ],
      "properties": {
        "sourceId": {"$ref": "#/$defs/safeId"},
        "sourceSha256": {"$ref": "#/$defs/sha256"},
        "mediaType": {"enum": ["application/pdf", "image/png", "image/jpeg", "image/tiff", "image/webp"]},
        "originType": {"enum": ["REPOSITORY_OWNED", "LICENSED_EXTERNAL", "PRIVATE_TEACHER_GOLD", "SYNTHETIC"]},
        "assetAvailability": {"enum": ["REPOSITORY_PUBLIC", "PRIVATE_REGISTRY", "EXTERNAL_REFERENCE_ONLY"]},
        "sourceReference": {"$ref": "#/$defs/safeRef"},
        "licenseMetadata": {"$ref": "#/$defs/licenseMetadata"}
      }
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goldId",
        "goldArtifactSha256",
        "goldFormat",
        "verificationStatus",
        "verifiedByRole",
        "separateFromEngineOutputs",
        "teacherCorrectionAutomaticallyTrainingData",
        "trainingAuthorization"
      ],
      "properties": {
        "goldId": {"$ref": "#/$defs/safeId"},
        "goldArtifactSha256": {"$ref": "#/$defs/sha256"},
        "goldFormat": {"enum": ["MUSICXML", "CANONICAL_SCORE", "ANNOTATION_JSON"]},
        "verificationStatus": {"enum": ["DRAFT", "VERIFIED"]},
        "verifiedByRole": {"enum": ["TEACHER", "REVIEW_PANEL"]},
        "separateFromEngineOutputs": {"const": true},
        "teacherCorrectionAutomaticallyTrainingData": {"const": false},
        "trainingAuthorization": {"enum": ["NOT_AUTHORIZED", "SEPARATELY_AUTHORIZED"]}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notationClasses", "notationFeatures", "scanConditions"],
      "properties": {
        "notationClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "MONOPHONIC",
              "VOICE_2",
              "VOICE_3",
              "VOICE_4_PLUS",
              "PIANO_GRAND_STAFF",
              "DENSE_PIANO_CHORD",
              "CLASSICAL_GUITAR_POLYPHONY",
              "INDEPENDENT_GUITAR_VOICES",
              "CROSS_STAFF_NOTATION"
            ]
          }
        },
        "notationFeatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "TIES",
              "SLURS",
              "TUPLETS",
              "GRACE_NOTES",
              "PICKUP_MEASURES",
              "IRREGULAR_MEASURES",
              "RESTS_IN_MULTIPLE_VOICES",
              "OVERLAPPING_DURATIONS",
              "ACCIDENTALS",
              "BEAMING",
              "STEM_DIRECTION_AMBIGUITY",
              "VOICE_REASSIGNMENT",
              "STAFF_REASSIGNMENT"
            ]
          }
        },
        "scanConditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CLEAN_OR_HIGH_QUALITY",
              "LOW_QUALITY_SCAN",
              "SKEW",
              "ROTATION",
              "PHONE_PHOTOGRAPH",
              "PERSPECTIVE_DISTORTION",
              "LOW_CONTRAST",
              "DAMAGED_OR_DIRTY_SCORE"
            ]
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "researchEvaluationOnly",
        "engineOutputsStoredSeparately",
        "automaticWinnerSelection",
        "automaticMusicXmlMerge",
        "automaticSemanticRepair",
        "teacherAuthority",
        "productionDecisionAuthority"
      ],
      "properties": {
        "researchEvaluationOnly": {"const": true},
        "engineOutputsStoredSeparately": {"const": true},
        "automaticWinnerSelection": {"const": false},
        "automaticMusicXmlMerge": {"const": false},
        "automaticSemanticRepair": {"const": false},
        "teacherAuthority": {"const": true},
        "productionDecisionAuthority": {"const": false}
      }
    }
  }
}
