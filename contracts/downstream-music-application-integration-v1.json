{
  "version": "scoremosaic-downstream-music-application-integration-v1",
  "status": "ARCHITECTURE_ONLY_FUTURE_DOWNSTREAM_INTEGRATION",
  "purpose": "Define how validated ScoreMosaic musical artifacts may later feed external or sibling music applications without granting those applications authority over Canonical Score, Teacher Review, approval or publication.",
  "integrationPoint": "after_canonical_and_teacher_review_validation",
  "sourcePolicy": {
    "rawOmrCandidateAllowed": false,
    "rawEngineOutputAllowed": false,
    "canonicalPreviewAllowed": true,
    "validatedTeacherRevisionPreviewAllowed": true,
    "productionDerivedOutputRequiresApprovedTeacherRevision": true,
    "correctedMusicXmlSha256Required": true,
    "revisionIdentityRequired": true
  },
  "lineage": {
    "requiredBindings": [
      "document_id",
      "canonical_score_id",
      "teacher_revision_id",
      "corrected_musicxml_sha256",
      "integration_request_id",
      "target_engine_version",
      "result_sha256"
    ],
    "staleRevisionResultMayRemainCurrent": false,
    "sourceMutationAllowed": false
  },
  "authority": {
    "downstreamEngineMayMutateCanonicalScore": false,
    "downstreamEngineMayCreateTeacherRevision": false,
    "downstreamEngineMayApprove": false,
    "downstreamEngineMayPublish": false,
    "downstreamOutputIsAuthoritativeMusicalTruth": false,
    "browserMayCallDownstreamEngineDirectly": false
  },
  "applicationBoundary": {
    "uiCallsTypedApplicationContract": true,
    "applicationUsesDedicatedAdapter": true,
    "adapterOwnsTransport": true,
    "directUiHttpCallsForbidden": true,
    "failureMustNotMutateScoreMosaicState": true
  },
  "guitarTabEngine": {
    "integrationName": "MusicXML-to-GuitarTab-Engine",
    "role": "downstream_guitar_arrangement_and_fingering_service",
    "input": "validated_or_approved_musicxml_with_exact_revision_lineage",
    "output": "non_authoritative_guitar_tab_and_fingering_candidates",
    "requiredContext": ["tuning", "fret_domain", "capo_policy", "instrument_profile"],
    "requiredEvidence": ["playability", "string_fret_assignment", "alternatives", "abstention_or_no_score_when_required"],
    "mayRewriteSourceMusic": false,
    "mayBeAddedToUiAsSeparateWorkspace": true
  },
  "stOrchestration": {
    "integrationName": "ST-Orchestration",
    "role": "downstream_bounded_symbolic_orchestration_proposal_service",
    "repository": "khfy7wpr5p-maker/ST-Orchestration",
    "pinnedCompatibilityCommit": "6c7f74fdbf13dd3acc2e0daa93cab7037d6a0a90",
    "specificContract": "contracts/st-orchestration-integration-v1.json",
    "input": "validated_or_approved_musicxml_with_exact_revision_lineage",
    "output": "non_authoritative_orchestration_proposals_alternatives_or_abstention",
    "supportedCapabilities": ["string-seat-ranking-v0"],
    "generalPianoToOrchestraSupported": false,
    "fullScoreOrchestrationSupported": false,
    "mayRewriteSourceMusic": false,
    "mayCreateTeacherRevision": false,
    "mayApprove": false,
    "mayPublish": false,
    "liveIntegrationActivated": false
  },
  "futureUiExtension": {
    "recommendedWorkspace": "guitar_tab_workspace",
    "mayAddNavigationWithoutChangingCoreTeacherReviewAuthority": true,
    "suggestedRegions": ["standard_notation", "guitar_tab", "fingering_options", "position_playability_evidence"]
  },
  "activationLocks": {
    "guitarTabLiveIntegrationActivated": false,
    "stOrchestrationLiveIntegrationActivated": false,
    "networkTransportActivated": false,
    "productionCredentialsActivated": false,
    "productionDerivedTabPublicationActivated": false,
    "productionOrchestrationInferenceActivated": false,
    "productionOrchestrationPublicationActivated": false
  }
}
