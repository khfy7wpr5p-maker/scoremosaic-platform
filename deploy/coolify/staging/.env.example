# ScoreMosaic Coolify staging: non-secret resource settings only.
# Copy these values into Coolify environment settings. Never commit real secrets.

COMPOSE_PROJECT_NAME=scoremosaic-staging

# Private OMR Gateway foundation
SCOREMOSAIC_GATEWAY_INTERNAL_HOST=omr-gateway
SCOREMOSAIC_GATEWAY_INTERNAL_PORT=8090
GATEWAY_CPUS=0.50
GATEWAY_MEMORY_LIMIT=256m
GATEWAY_TMPFS_BYTES=16777216

# HOMR health-only foundation limits
HOMR_CPUS=1.00
HOMR_MEMORY_LIMIT=768m
HOMR_TMPFS_BYTES=33554432

# Clarity health-only foundation limits
CLARITY_CPUS=1.00
CLARITY_MEMORY_LIMIT=1024m
CLARITY_TMPFS_BYTES=33554432

# Pinned Audiveris 5.11.0 runtime limits
AUDIVERIS_CPUS=2.00
AUDIVERIS_MEMORY_LIMIT=4096m
AUDIVERIS_TMPFS_BYTES=805306368
AUDIVERIS_JNA_TMPFS_BYTES=67108864
