# Runtime mode
APP_ENV=development
LOG_LEVEL=info

# Public API listener (planned)
ENSEMBLE_HOST=0.0.0.0
ENSEMBLE_PORT=8080

# Internal service addresses inside the container network
HOMR_BASE_URL=http://homr-service:8000
CLARITY_BASE_URL=http://clarity-service:8000

# Upload and processing limits
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=50
JOB_TIMEOUT_SECONDS=300
RESULT_RETENTION_HOURS=24

# Replace through Codespaces/Coolify secret storage. Never commit a real value.
INTERNAL_API_TOKEN=replace-with-secret-store-value
